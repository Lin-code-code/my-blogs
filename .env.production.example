# ===== 后端（docker compose 读取）=====
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
# 换成服务器公网 IP
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://lin-blog.netlify.app
DJANGO_COOKIE_SAMESITE=Lax
# 后端只有 HTTP，必须设 0，否则 Admin 登录 Cookie 存不下来
DJANGO_COOKIE_SECURE=0

# ===== PostgreSQL（compose 里的 db 容器）=====
DB_NAME=my_blogs
DB_USER=my_blogs
DB_PASSWORD=replace-with-strong-password
DB_HOST=db
DB_PORT=5432

# ===== 前端构建变量：填在 Netlify 站点环境变量里，不要写进服务器 .env =====
# BLOG_API_BASE_URL=http://YOUR_SERVER_IP:8000
# VITE_API_BASE_URL=
# VITE_BASE_PATH=/
