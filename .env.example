# Django
# 前端 dev 端口要写全，端口对不上时 POST/PUT/DELETE 会被 Django 的 Origin 校验挡成 403
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
DJANGO_COOKIE_SAMESITE=Lax
# 后端走 HTTPS 时设为 1；本地 HTTP 开发保持 0
DJANGO_COOKIE_SECURE=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=my_blogs
DB_USER=my_blogs
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=5433

# Frontend build
VITE_API_BASE_URL=
BLOG_API_BASE_URL=http://127.0.0.1:8000
VITE_BASE_PATH=/
